# AI Router — environment variables
# Copy this to .env and fill in your credentials
# Or just run: bash setup.sh (it will guide you through this)

# ── Claude (claude.ai) ────────────────────────────────────────────────────────
# DevTools → Application → Cookies → claude.ai → sessionKey
CLAUDE_SESSION_KEY=
# Optional: HTTP or SOCKS5 proxy to bypass Cloudflare on servers/VPNs
# Format: http://user:pass@host:port  or  socks5://user:pass@host:port
CLAUDE_PROXY_URL=

# ── Gemini (gemini.google.com) ────────────────────────────────────────────────
# DevTools → Application → Cookies → gemini.google.com
GEMINI_1PSID=
GEMINI_1PSIDTS=

# ── ChatGPT (chatgpt.com) ─────────────────────────────────────────────────────
# DevTools → Application → Cookies → chatgpt.com → __Secure-next-auth.session-token
CHATGPT_SESSION_TOKEN=

# ── Kimi (kimi.ai) ───────────────────────────────────────────────────────────
# DevTools → Application → Cookies → kimi.ai → refresh_token
KIMI_REFRESH_TOKEN=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=changeme

# ── Port (0 = auto-detect) ────────────────────────────────────────────────────
ROUTER_PORT=0
